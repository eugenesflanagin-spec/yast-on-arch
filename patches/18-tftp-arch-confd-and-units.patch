diff --git a/test/cfa/tftp_sysconfig_test.rb b/test/cfa/tftp_sysconfig_test.rb
index ffd2b22..51b8d3a 100644
--- a/test/cfa/tftp_sysconfig_test.rb
+++ b/test/cfa/tftp_sysconfig_test.rb
@@ -3,7 +3,15 @@ require_relative "../test_helper"
 require "cfa/memory_file"
 require "cfa/tftp_sysconfig"
 
+# ARCH PORT: the fixture is Arch's /etc/conf.d/tftpd, which packs every setting
+# into one TFTPD_ARGS string, rather than SUSE's /etc/sysconfig/tftp with its
+# three separate TFTP_* keys.  See CFA::TftpSysconfig for why.
 describe CFA::TftpSysconfig do
+  def model_for(content)
+    handler = CFA::MemoryFile.new(content)
+    described_class.new(file_handler: handler).tap(&:load)
+  end
+
   let(:file_handler) do
     file_path = File.expand_path("../../data/tftp_sysconfig", __FILE__)
     CFA::MemoryFile.new(File.read(file_path))
@@ -18,19 +26,65 @@ describe CFA::TftpSysconfig do
   end
 
   describe "#load" do
-    it "loads all attributes" do
-      expect(subject.user).to eq "tftp"
-      expect(subject.directory).to eq "/srv/tftpboot"
-      expect(subject.options).to eq ""
+    it "derives the attributes from TFTPD_ARGS" do
+      expect(subject.directory).to eq "/srv/tftp/"
+      expect(subject.options).to eq "--secure"
+    end
+
+    it "falls back to in.tftpd's own default user when --user is absent" do
+      expect(subject.user).to eq "nobody"
+    end
+
+    it "reads an explicit --user" do
+      expect(model_for('TFTPD_ARGS="--secure --user tftp /srv/tftp"').user).to eq "tftp"
+    end
+
+    it "understands the short -u form and keeps it out of the options" do
+      model = model_for('TFTPD_ARGS="-u nobody -s /srv/tftp"')
+      expect(model.user).to eq "nobody"
+      expect(model.directory).to eq "/srv/tftp"
+      expect(model.options).to eq "-s"
+    end
+
+    it "does not mistake a value-taking flag's value for the directory" do
+      model = model_for('TFTPD_ARGS="--secure --blocksize 1428 /srv/tftp"')
+      expect(model.directory).to eq "/srv/tftp"
+      expect(model.options).to eq "--secure --blocksize 1428"
+    end
+
+    it "copes with no directory at all" do
+      expect(model_for('TFTPD_ARGS="--secure"').directory).to eq ""
+    end
+
+    # The bug this port fixes: a missing file must not raise, or the whole
+    # tftp-server client dies before drawing a dialog.
+    it "treats a missing file as an empty configuration" do
+      handler = double("handler")
+      allow(handler).to receive(:read).and_raise(Errno::ENOENT)
+      model = described_class.new(file_handler: handler)
+      expect { model.load }.to_not raise_error
+      expect(model.directory).to eq ""
+      expect(model.user).to eq "nobody"
     end
   end
 
   describe "#save" do
-    it "stores properly attributes" do
+    it "writes the user back into TFTPD_ARGS, preserving the other options" do
       subject.user = "root"
       subject.save
 
-      expect(file_handler.content.lines).to include("TFTP_USER=\"root\"\n")
+      expect(file_handler.content).to include("--user root")
+      expect(file_handler.content).to include("--secure")
+      expect(file_handler.content).to include("/srv/tftp/")
+    end
+
+    it "replaces the directory without disturbing the options" do
+      subject.directory = "/srv/tftpboot"
+      subject.save
+
+      expect(subject.directory).to eq "/srv/tftpboot"
+      expect(subject.options).to eq "--secure"
+      expect(file_handler.content).to include("TFTPD_ARGS")
     end
   end
 end
