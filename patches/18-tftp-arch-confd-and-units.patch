diff --git a/src/lib/cfa/tftp_sysconfig.rb b/src/lib/cfa/tftp_sysconfig.rb
index d941086..d5d03aa 100644
--- a/src/lib/cfa/tftp_sysconfig.rb
+++ b/src/lib/cfa/tftp_sysconfig.rb
@@ -1,19 +1,189 @@
 require "cfa/base_model"
 require "cfa/augeas_parser"
+require "shellwords"
 
 module CFA
+  # Configuration of the tftp server.
+  #
+  # ARCH PORT
+  # ---------
+  # On SUSE this reads /etc/sysconfig/tftp, which holds three separate keys
+  # (TFTP_USER, TFTP_DIRECTORY, TFTP_OPTIONS).  Arch has no /etc/sysconfig at
+  # all, so the original path does not exist and CFA's load raised
+  # Errno::ENOENT, killing the whole tftp-server client before it drew a single
+  # dialog ("Client .../tftp-server.rb failed with 'No such file or directory
+  # @ rb_sysopen - /etc/sysconfig/tftp'").
+  #
+  # Arch's tftp-hpa ships the equivalent file at a different path and in a
+  # different shape -- /usr/lib/systemd/system/tftpd.service has:
+  #
+  #     EnvironmentFile=/etc/conf.d/tftpd
+  #     ExecStart=/usr/bin/in.tftpd --listen $TFTPD_ARGS
+  #
+  # so every setting lives in ONE shell variable, e.g. the stock file is:
+  #
+  #     TFTPD_ARGS="--secure /srv/tftp/"
+  #
+  # This model therefore keeps the same three-attribute interface the rest of
+  # the module already uses (#user, #directory, #options) but derives them from
+  # (and recomposes them into) that single string.  Nothing outside this file
+  # has to know that Arch packs them together.
   class TftpSysconfig < BaseModel
-    attributes(
-      user:      "TFTP_USER",
-      directory: "TFTP_DIRECTORY",
-      options:   "TFTP_OPTIONS"
-    )
+    # The single variable tftpd.service expands into in.tftpd's argv.
+    attributes(args: "TFTPD_ARGS")
 
-    PATH = "/etc/sysconfig/tftp".freeze
+    PATH = "/etc/conf.d/tftpd".freeze
+
+    # in.tftpd options that consume the NEXT token as their value.  Taken from
+    # in.tftpd(8) -- note --secure/-s, --create/-c, --permissive/-p,
+    # --foreground/-f, --listen/-l and --verbose/-v take none, which is why a
+    # plain list of "flags" is not enough to find the directory.
+    VALUE_FLAGS = [
+      "-a", "--address",
+      "-B", "--blocksize",
+      "-m", "--mapfile",
+      "-P", "--pidfile",
+      "-r", "--refuse",
+      "-R", "--port-range",
+      "-T", "--timeout",
+      "-t", "--retransmit",
+      "-u", "--user",
+      "-U", "--umask",
+      "-V", "--verbosity"
+    ].freeze
+
+    USER_FLAGS = ["-u", "--user"].freeze
+
+    # in.tftpd's own default when --user is not given.
+    DEFAULT_USER = "nobody".freeze
 
     def initialize(file_handler: nil)
-      super(AugeasParser.new("sysconfig.lns"), PATH,
-        file_handler: file_handler)
+      super(AugeasParser.new("sysconfig.lns"), PATH, file_handler: file_handler)
+    end
+
+    # Tolerate the file being absent.
+    #
+    # tftp-hpa does ship /etc/conf.d/tftpd, but a missing file must mean "no
+    # settings yet, use defaults" rather than an exception that takes the whole
+    # client down -- that is the exact bug this port is fixing, and it should
+    # not simply move to a new path.
+    def load
+      super
+    rescue Errno::ENOENT
+      self.data = @parser.empty
+      @loaded = true
+    end
+
+    # The directory served, i.e. the last positional (non-option) token.
+    # @return [String] "" when TFTPD_ARGS names no directory
+    def directory
+      positional_args.last || ""
+    end
+
+    def directory=(value)
+      self.args = compose(option_args, value)
+    end
+
+    # The user in.tftpd drops privileges to.
+    #
+    # Never returns nil: TftpServer#WriteOnly interpolates this straight into
+    # "chown #{user}: dir", and "chown : dir" is a syntax error.
+    # @return [String]
+    def user
+      tokens = arg_tokens
+      idx = tokens.index { |t| USER_FLAGS.include?(t) }
+      value = idx && tokens[idx + 1]
+      value && !value.empty? ? value : DEFAULT_USER
+    end
+
+    def user=(value)
+      opts = strip_user_flag(option_args)
+      opts += ["--user", value.to_s] unless value.nil? || value.to_s.empty?
+      self.args = compose(opts, directory)
+    end
+
+    # Everything that is not the user flag or the directory, preserved verbatim
+    # (so --secure, --create, --blocksize 1428 and friends survive a save).
+    # @return [String]
+    def options
+      Shellwords.join(strip_user_flag(option_args))
+    end
+
+    def options=(value)
+      opts = Shellwords.split(value.to_s)
+      u = user
+      opts += ["--user", u] unless u == DEFAULT_USER || opts.any? { |t| USER_FLAGS.include?(t) }
+      self.args = compose(opts, directory)
+    end
+
+  private
+
+    def arg_tokens
+      Shellwords.split(args.to_s)
+    rescue ArgumentError # unbalanced quotes in a hand-edited file
+      args.to_s.split
+    end
+
+    # Tokens that belong to options (flags and their values), i.e. everything
+    # except the positional directory arguments.
+    def option_args
+      tokens = arg_tokens
+      out = []
+      expect_value = false
+      tokens.each do |t|
+        if expect_value
+          out << t
+          expect_value = false
+        elsif t.start_with?("-")
+          out << t
+          expect_value = VALUE_FLAGS.include?(t)
+        end
+      end
+      out
+    end
+
+    def positional_args
+      tokens = arg_tokens
+      out = []
+      expect_value = false
+      tokens.each do |t|
+        if expect_value
+          expect_value = false
+        elsif t.start_with?("-")
+          expect_value = VALUE_FLAGS.include?(t)
+        else
+          out << t
+        end
+      end
+      out
+    end
+
+    # Drop "--user X" from a token list, keeping every other flag and its value.
+    def strip_user_flag(opts)
+      out = []
+      skip = false
+      opts.each_with_index do |t, i|
+        if skip
+          skip = false
+          next
+        end
+        if USER_FLAGS.include?(t)
+          skip = true # also drop its value
+          next
+        end
+        out << t
+        if VALUE_FLAGS.include?(t) && opts[i + 1]
+          out << opts[i + 1]
+          skip = true
+        end
+      end
+      out
+    end
+
+    def compose(opts, dir)
+      tokens = Array(opts)
+      tokens += [dir.to_s] unless dir.nil? || dir.to_s.empty?
+      Shellwords.join(tokens)
     end
   end
 end
