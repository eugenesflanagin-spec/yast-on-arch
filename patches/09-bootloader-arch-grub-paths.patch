diff --git a/src/lib/bootloader/grub_install.rb b/src/lib/bootloader/grub_install.rb
index 70d0476..d9ba9e1 100644
--- a/src/lib/bootloader/grub_install.rb
+++ b/src/lib/bootloader/grub_install.rb
@@ -84,10 +84,13 @@ module Bootloader
     # creates basic command for grub2 install without specifying any stage1
     # locations
     def basic_cmd(secure_boot, update_nvram)
-      if Systeminfo.shim_needed?(@grub2_name, secure_boot)
-        cmd = ["/usr/sbin/shim-install", "--config-file=/boot/grub2/grub.cfg"]
+      # Arch port: shim-install is an openSUSE/Debian shim-signed helper and does
+      # not exist on Arch, so guard on the binary rather than renaming it; grub2-*
+      # becomes GRUB's upstream grub-*.
+      if Systeminfo.shim_needed?(@grub2_name, secure_boot) && ::File.exist?("/usr/sbin/shim-install")
+        cmd = ["/usr/sbin/shim-install", "--config-file=/boot/grub/grub.cfg"]
       else
-        cmd = ["/usr/sbin/grub2-install", "--target=#{target}"]
+        cmd = ["grub-install", "--target=#{target}"]
         # Do skip-fs-probe to avoid error when embedding stage1
         # to extended partition
         cmd << "--force" << "--skip-fs-probe"
