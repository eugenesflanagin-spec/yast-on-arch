Control Center: search no longer freezes with thousands of modules.

Each keystroke in the search field called setFilterFixedString(), which the
proxy applies as many separate row removals; KCategorizedView rebuilds its
whole layout after every one, asking every item for its size hint twice, and
each size hint re-read the item's icon file (QIcon::fromTheme, no cache).
With ~5,200 modules that is millions of PNG decodes per keystroke.

- cache icons in YQDesktopFilesModel::findIcon
- match the name in filterAcceptsRow and apply a filter change with a single
  invalidate() (one layoutChanged) instead of per-block row removals
- force one relayout after a filter change (layoutChanged alone only relays
  out when the row count changed)
- one sizeHintForIndex() call per item instead of two

Applies on top of patch 07.

diff --git a/src/kcategorizedsortfilterproxymodel.cpp b/src/kcategorizedsortfilterproxymodel.cpp
index c571fb2..130e856 100644
--- a/src/kcategorizedsortfilterproxymodel.cpp
+++ b/src/kcategorizedsortfilterproxymodel.cpp
@@ -311,7 +311,12 @@ bool KCategorizedSortFilterProxyModel::filterAcceptsRow( int row, const QModelIn
     QStringList keywordList = sourceModel()->data( i1, KeywordsRole ).toStringList();
     QString keywords = keywordList.join(" ");
 
-    bool nameMatches = QSortFilterProxyModel::filterAcceptsRow( row, srcindex ); 
+    // Match the name ourselves instead of via setFilterFixedString(): the base
+    // class applies a filter change as many separate row removals, and the
+    // categorized view rebuilds itself completely after each one.
+    QModelIndex ik = sourceModel()->index( row, filterKeyColumn(), srcindex );
+    bool nameMatches = sourceModel()->data( ik, filterRole() ).toString()
+	.contains( d->filterString, Qt::CaseInsensitive );
     bool keywordMatches = ( !keywords.isEmpty() && keywords.contains( filterFixedString()) );
 
     if( nameMatches || keywordMatches )
@@ -326,10 +331,11 @@ bool KCategorizedSortFilterProxyModel::filterAcceptsRow( int row, const QModelIn
 void KCategorizedSortFilterProxyModel::customFilterFunction( const QString &s )
 {    
     d->filterGroups.clear();
-    setFilterFixedString( s );
-    d->filterString = s; 
-    invalidateFilter();
+    d->filterString = s;
+    // One layoutChanged instead of a removal per filtered-out block
     invalidate();
+    // Build the mapping now so filterGroups is complete for the group filter
+    rowCount();
 }
 
 QString KCategorizedSortFilterProxyModel::matchingGroupFilterRegexp()
