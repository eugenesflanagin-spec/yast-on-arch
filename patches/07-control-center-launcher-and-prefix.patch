diff --git i/src/main_window.cpp w/src/main_window.cpp
index eaf5dcf..0964ae8 100644
--- i/src/main_window.cpp
+++ w/src/main_window.cpp
@@ -290,8 +290,19 @@ void MainWindow::slotLaunchModule( const QModelIndex &index)
     QString argument = d->modmodel->data( i2, Qt::UserRole ).toString();
     QString name = d->modmodel->data( i3, Qt::UserRole ).toString();
 
+    // ARCH PORT: never launch an empty client (a stray activation at start-up
+    // on a group headline produced "yast -r -q" with no module).
+    if ( client.isEmpty() )
+        return;
+
     // Do not send HUP signal when control center is closed, bsc#1154854.
-    QString cmd = QString("/usr/bin/nohup /usr/sbin/yast2 ");
+    // ARCH PORT (yast-on-arch): there is no /usr/sbin/yast2. The launcher
+    // (bin/yast) is passed in $YAST_LAUNCHER; "-r -q" = escalate via sudo,
+    // Qt front-end. The control center itself runs as the plain user.
+    QString launcher = QString::fromLocal8Bit( qgetenv( "YAST_LAUNCHER" ) );
+    if ( launcher.isEmpty() )
+        launcher = "/usr/sbin/yast2";
+    QString cmd = QString("/usr/bin/nohup ") + launcher + " -r -q ";
     cmd += client;
 
     if ( d->noBorder )	
@@ -307,7 +318,10 @@ void MainWindow::slotLaunchModule( const QModelIndex &index)
     }
 
     // Redirect nohup output to ensure that $HOME/nohup.out file is not created (bsc#1189651)
-    cmd += " > /var/log/YaST2/nohup.out 2>&1 &";
+    // ARCH PORT: /var/log/YaST2 is root-only here; log next to the launcher log.
+    QString rt = QString::fromLocal8Bit( qgetenv( "XDG_RUNTIME_DIR" ) );
+    if ( rt.isEmpty() ) rt = "/tmp";
+    cmd += " >> " + rt + "/yast-on-arch.log 2>&1 &";
 
     //FIXME: use something more intelligent (unique) to remember used modules, names suck
     d->recentlyUsed.enqueue( name );  
