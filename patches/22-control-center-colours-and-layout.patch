+
+namespace
+{
+    // a line edit with a "Browse..." button next to it
+    QWidget *withBrowse( QLineEdit *edit, QWidget *parent, const QString &title, const QString &filter )
+    {
+        QWidget *w = new QWidget( parent );
+        QHBoxLayout *l = new QHBoxLayout( w );
+        l->setContentsMargins( 0, 0, 0, 0 );
+        QPushButton *b = new QPushButton( _("Browse...") );
+        l->addWidget( edit, 1 );
+        l->addWidget( b );
+
+        QObject::connect( b, &QPushButton::clicked, w, [=]()
+        {
+            const QString f = QFileDialog::getOpenFileName( w, title, edit->text(), filter );
+            if ( !f.isEmpty() )
+                edit->setText( f );
+        } );
+
+        return w;
+    }
+
+    QLabel *hint( const QString &text )
+    {
+        QLabel *l = new QLabel( text );
+        l->setWordWrap( true );
+        QFont f = l->font();
+        f.setItalic( true );
+        l->setFont( f );
+        return l;
+    }
+}
+
+LayoutDialog::LayoutDialog( const QList<LayoutSection> &sections, const QList<LayoutEntry> &entries,
+                            QWidget *parent )
+    : QDialog( parent ), m_sections( sections ), m_entries( entries )
+{
+    setWindowTitle( _("Add or change") );
+
+    QVBoxLayout *top = new QVBoxLayout( this );
+    m_tabs = new QTabWidget( this );
+    top->addWidget( m_tabs );
+
+    // ---- Add a program
+    {
+        QWidget *page = new QWidget();
+        QFormLayout *f = new QFormLayout( page );
+        m_appName = new QLineEdit();
+        m_appExec = new QLineEdit();
+        m_appIcon = new QLineEdit();
+        m_appComment = new QLineEdit();
+        m_appKeywords = new QLineEdit();
+        m_appSection = new QComboBox();
+        m_appTerminal = new QCheckBox( _("Run it in a terminal window that stays open") );
+        m_appExec->setPlaceholderText( _("program and its options, e.g.  htop") );
+        m_appIcon->setPlaceholderText( _("icon name (e.g. utilities-terminal) or an image file") );
+        m_appKeywords->setPlaceholderText( _("extra search words, separated by commas") );
+        fillSectionBox( m_appSection );
+
+        f->addRow( _("&Name:"), m_appName );
+        f->addRow( _("&Command:"), withBrowse( m_appExec, page, _("Choose a program"), QString() ) );
+        f->addRow( _("&Icon:"), withBrowse( m_appIcon, page, _("Choose an icon"),
+                                           _("Images (*.png *.svg *.svgz *.xpm *.jpg)") ) );
+        f->addRow( _("&Description:"), m_appComment );
+        f->addRow( _("&Keywords:"), m_appKeywords );
+        f->addRow( _("&Section:"), m_appSection );
+        f->addRow( QString(), m_appTerminal );
+
+        QPushButton *go = new QPushButton( _("&Add program") );
+        f->addRow( QString(), go );
+        connect( go, &QPushButton::clicked, this, &LayoutDialog::addApp );
+        m_tabs->addTab( page, _("Add a program") );
+    }
+
+    // ---- Add a section
+    {
+        QWidget *page = new QWidget();
+        QFormLayout *f = new QFormLayout( page );
+        m_secName = new QLineEdit();
+        m_secIcon = new QLineEdit();
+        m_secIcon->setPlaceholderText( _("icon name or an image file (default: folder)") );
+        m_secGenre = new QComboBox();
+        m_secGenre->setEditable( true );
+        m_secGenre->addItem( QString() );
+
+        // genres = the part before " - " of the existing section names
+        QSet<QString> genres;
+        for ( const LayoutSection &s : m_sections )
+            if ( s.name.contains( " - " ) )
+                genres.insert( s.name.section( " - ", 0, 0 ).trimmed() );
+        QStringList sorted = genres.values();
+        sorted.sort( Qt::CaseInsensitive );
+        m_secGenre->addItems( sorted );
+
+        f->addRow( _("&Name:"), m_secName );
+        f->addRow( _("&Genre:"), m_secGenre );
+        f->addRow( QString(), hint( _("Pick a genre to give the section that genre's colour "
+                                      "(it is called \"Genre - Name\"), type a new genre for a "
+                                      "colour of its own, or leave it empty.") ) );
+        f->addRow( _("&Icon:"), withBrowse( m_secIcon, page, _("Choose an icon"),
+                                           _("Images (*.png *.svg *.svgz *.xpm *.jpg)") ) );
+
+        QPushButton *go = new QPushButton( _("&Add section") );
+        f->addRow( QString(), go );
+        connect( go, &QPushButton::clicked, this, &LayoutDialog::addSection );
+        m_tabs->addTab( page, _("Add a section") );
+    }
+
+    // ---- Move a program
+    {
+        QWidget *page = new QWidget();
+        QFormLayout *f = new QFormLayout( page );
+        m_moveEntry = new QComboBox();
+        m_moveTo = new QComboBox();
+
+        QList<LayoutEntry> sorted = m_entries;
+        std::sort( sorted.begin(), sorted.end(), []( const LayoutEntry &a, const LayoutEntry &b )
+                   { return a.name.compare( b.name, Qt::CaseInsensitive ) < 0; } );
+        for ( const LayoutEntry &e : sorted )
+            m_moveEntry->addItem( e.name, e.file );
+        fillSectionBox( m_moveTo );
+
+        // preselect the section the chosen program is in now
+        auto follow = [this]()
+        {
+            const QString file = m_moveEntry->currentData().toString();
+            for ( const LayoutEntry &e : m_entries )
+                if ( e.file == file )
+                    m_moveTo->setCurrentIndex( qMax( 0, m_moveTo->findData( e.section ) ) );
+        };
+        connect( m_moveEntry, QOverload<int>::of( &QComboBox::currentIndexChanged ), this, follow );
+        follow();
+
+        f->addRow( _("&Program:"), m_moveEntry );
+        f->addRow( _("&To section:"), m_moveTo );
+        f->addRow( QString(), hint( _("Works for every program, also the ones that came with YaST. "
+                                      "The installed files are not changed, so \"Put back\" always "
+                                      "returns it to its own section.") ) );
+
+        QHBoxLayout *b = new QHBoxLayout();
+        QPushButton *go = new QPushButton( _("&Move") );
+        QPushButton *back = new QPushButton( _("&Put back") );
+        b->addWidget( go );
+        b->addWidget( back );
+        b->addStretch();
+        f->addRow( QString(), b );
+        connect( go, &QPushButton::clicked, this, [this]() { moveApp( false ); } );
+        connect( back, &QPushButton::clicked, this, [this]() { moveApp( true ); } );
+        m_tabs->addTab( page, _("Move a program") );
+    }
+
+    // ---- Rename a section
+    {
+        QWidget *page = new QWidget();
+        QFormLayout *f = new QFormLayout( page );
+        m_renSection = new QComboBox();
+        m_renName = new QLineEdit();
+        fillSectionBox( m_renSection );
+
+        auto follow = [this]() { m_renName->setText( m_renSection->currentText() ); };
+        connect( m_renSection, QOverload<int>::of( &QComboBox::currentIndexChanged ), this, follow );
+        follow();
+
+        f->addRow( _("&Section:"), m_renSection );
+        f->addRow( _("New &name:"), m_renName );
+        f->addRow( QString(), hint( _("The section keeps its colour. \"Original name\" gives it its "
+                                      "own name back.") ) );
+
+        QHBoxLayout *b = new QHBoxLayout();
+        QPushButton *go = new QPushButton( _("&Rename") );
+        QPushButton *back = new QPushButton( _("&Original name") );
+        b->addWidget( go );
+        b->addWidget( back );
+        b->addStretch();
+        f->addRow( QString(), b );
+        connect( go, &QPushButton::clicked, this, [this]() { renameSection( false ); } );
+        connect( back, &QPushButton::clicked, this, [this]() { renameSection( true ); } );
+        m_tabs->addTab( page, _("Rename a section") );
+    }
+
+    m_result = new QLabel();
+    m_result->setWordWrap( true );
+    m_result->setTextInteractionFlags( Qt::TextSelectableByMouse );
+    top->addWidget( m_result );
+
+    QDialogButtonBox *box = new QDialogButtonBox( QDialogButtonBox::Close );
+    connect( box, &QDialogButtonBox::rejected, this, &QDialog::reject );
+    top->addWidget( box );
+
+    resize( 620, 420 );
+}
+
+void LayoutDialog::showPage( Page page, const QString &entryFile )
+{
+    m_tabs->setCurrentIndex( page );
+
+    if ( page == MoveApp && !entryFile.isEmpty() )
+    {
+        const int i = m_moveEntry->findData( entryFile );
+        if ( i >= 0 )
+            m_moveEntry->setCurrentIndex( i );
+    }
+}
+
+void LayoutDialog::fillSectionBox( QComboBox *box )
+{
+    QList<LayoutSection> sorted = m_sections;
+    std::sort( sorted.begin(), sorted.end(), []( const LayoutSection &a, const LayoutSection &b )
+               { return a.name.compare( b.name, Qt::CaseInsensitive ) < 0; } );
+    for ( const LayoutSection &s : sorted )
+        box->addItem( s.name, s.id );
+}
+
+QString LayoutDialog::chosenSection( QComboBox *box ) const
+{
+    return box->currentData().toString();
+}
+
+bool LayoutDialog::run( const QStringList &args )
+{
+    // the launcher sets YAST_LAUNCHER; otherwise use "yast" from PATH
+    QString launcher = qEnvironmentVariable( "YAST_LAUNCHER" );
+    if ( launcher.isEmpty() )
+        launcher = "yast";
+
+    QProcess p;
+    // YAST_LOG_DIRECT: we read the output ourselves, so the launcher writes no log
+    // banner and does not hand stderr to a background "tee"
+    QProcessEnvironment env = QProcessEnvironment::systemEnvironment();
+    env.insert( "YAST_LOG_DIRECT", "1" );
+    p.setProcessEnvironment( env );
+    p.setProcessChannelMode( QProcess::SeparateChannels );
+    p.start( launcher, args );
+
+    if ( !p.waitForStarted( 10000 ) )
+    {
+        m_result->setText( _("Could not start %1.").arg( launcher ) );
+        return false;
+    }
+
+    if ( !p.waitForFinished( 120000 ) )
+    {
+        p.kill();
+        p.waitForFinished( 3000 );
+        m_result->setText( _("Not done: it took too long and was stopped.") );
+        return false;
+    }
+
+    // drop the launcher's log banner and the "yast: " prefix of each line
+    auto tidy = []( const QByteArray &raw )
+    {
+        QStringList lines;
+        for ( QString line : QString::fromLocal8Bit( raw ).split( '\n' ) )
+        {
+            if ( line.startsWith( "--- " ) && line.contains( " launch: " ) )
+                continue;
+            if ( line.startsWith( "yast: " ) )
+                line.remove( 0, 6 );
+            if ( !line.trimmed().isEmpty() )
+                lines << line;
+        }
+        return lines.join( '\n' );
+    };
+
+    const QString out = tidy( p.readAllStandardOutput() );
+    const QString err = tidy( p.readAllStandardError() );
+
+    const bool ok = p.exitStatus() == QProcess::NormalExit && p.exitCode() == 0;
+    if ( ok )
+    {
+        m_changed = true;
+        m_result->setText( out + "\n" + _("Close this window to restart the Control Center and see it.") );
+    }
+    else
+        m_result->setText( _("Not done: %1").arg( err.isEmpty() ? out : err ) );
+
+    return ok;
+}
+
+void LayoutDialog::addApp()
+{
+    QStringList args { "add-app", "--name", m_appName->text().trimmed(),
+                       "--exec", m_appExec->text().trimmed(),
+                       "--section", chosenSection( m_appSection ) };
+
+    if ( !m_appIcon->text().trimmed().isEmpty() )
+        args << "--icon" << m_appIcon->text().trimmed();
+    if ( !m_appComment->text().trimmed().isEmpty() )
+        args << "--comment" << m_appComment->text().trimmed();
+    if ( !m_appKeywords->text().trimmed().isEmpty() )
+        args << "--keywords" << m_appKeywords->text().trimmed();
+    if ( m_appTerminal->isChecked() )
+        args << "--terminal";
+
+    run( args );
+}
+
+void LayoutDialog::addSection()
+{
+    QStringList args { "add-section", "--name", m_secName->text().trimmed() };
+
+    if ( !m_secGenre->currentText().trimmed().isEmpty() )
+        args << "--genre" << m_secGenre->currentText().trimmed();
+    if ( !m_secIcon->text().trimmed().isEmpty() )
+        args << "--icon" << m_secIcon->text().trimmed();
+
+    run( args );
+}
+
+void LayoutDialog::moveApp( bool reset )
+{
+    const QString file = m_moveEntry->currentData().toString();
+
+    if ( reset )
+        run( { "move-app", file, "--reset" } );
+    else
+        run( { "move-app", file, "--to", chosenSection( m_moveTo ) } );
+}
+
+void LayoutDialog::renameSection( bool reset )
+{
+    const QString id = chosenSection( m_renSection );
+
+    if ( reset )
+        run( { "rename-section", id, "--reset" } );
+    else
+        run( { "rename-section", id, "--to", m_renName->text().trimmed() } );
+}
