+++ i/src/sectioncolors.h
@@ -0,0 +1,48 @@
+/****************************************************************************
+|
+| Copyright (c) 2026 yast-on-arch contributors
+|
+| This program is free software; you can redistribute it and/or
+| modify it under the terms of version 2 of the GNU General Public License as
+| published by the Free Software Foundation.
+|
+| This program is distributed in the hope that it will be useful,
+| but WITHOUT ANY WARRANTY; without even the implied warranty of
+| MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.   See the
+| GNU General Public License for more details.
+|
+ \***************************************************************************/
+
+/*
+ * ARCH PORT: colour-coded sections.
+ *
+ * Every group gets a colour from its family (the part of the name before
+ * " - ", e.g. "Graphics - Vector" -> Graphics), so related sections share
+ * one colour. The "Section colours" box in the sidebar switches between
+ * Off, Headers and Whole block; colours can be changed in
+ * ~/.config/yast-on-arch/section-colors.ini, where [Aliases] can also put a
+ * group into another family (see sectioncolors.cpp).
+ */
+
+#ifndef SECTIONCOLORS_H
+#define SECTIONCOLORS_H
+
+#include <QColor>
+#include <QString>
+
+enum SectionColorMode
+{
+    SectionColorsOff = 0,       // no colours
+    SectionColorsHeaders = 1,   // coloured section headers + sidebar stripes
+    SectionColorsBlocks = 2,    // as Headers, and the whole section is tinted
+};
+
+// Colour for a group's display name; invalid QColor when colours are off.
+QColor sectionColor( const QString &groupName );
+
+SectionColorMode sectionColorMode();
+
+// Changes the mode and saves it to section-colors.ini.
+void setSectionColorMode( SectionColorMode mode );
+
+#endif
