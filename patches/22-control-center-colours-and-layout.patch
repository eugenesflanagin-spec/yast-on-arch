index 0000000..1037a2f
--- /dev/null
+++ i/src/sectioncolors.cpp
@@ -0,0 +1,266 @@
+/****************************************************************************
+|
+| Copyright (c) 2026 yast-on-arch contributors
+|
+| This program is free software; you can redistribute it and/or
+| modify it under the terms of version 2 of the GNU General Public License as
+| published by the Free Software Foundation.
+|
+| This program is distributed in the hope that it will be useful,
+| but WITHOUT ANY WARRANTY; without even the implied warranty of
+| MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.   See the
+| GNU General Public License for more details.
+|
+ \***************************************************************************/
+
+/*
+ * ARCH PORT: colour-coded sections, see sectioncolors.h.
+ *
+ * Optional ~/.config/yast-on-arch/section-colors.ini:
+ *
+ *   [General]
+ *   Mode=headers            ; off | headers | blocks (also set from the
+ *                           ; "Section colours" box under the search field)
+ *
+ *   [Colors]
+ *   Graphics=#e05c8a        ; override a family (or a full group name,
+ *                           ; e.g. "More - System - Containers=#2e86c1")
+ *
+ *   [Aliases]
+ *   My Tools=Development    ; a group (full name) uses that family's colour;
+ *                           ; also works for "More - System - <category>"
+ *
+ * Families without an entry in the built-in table get a stable colour
+ * derived from their name.
+ */
+
+#include "sectioncolors.h"
+#include "layoutoverlay.h"
+
+#include <QDir>
+#include <QHash>
+#include <QSettings>
+
+namespace
+{
+    QString iniPath()
+    {
+        return QDir::homePath() + "/.config/yast-on-arch/section-colors.ini";
+    }
+
+    struct SectionColors
+    {
+        SectionColorMode mode = SectionColorsHeaders;
+        QHash<QString, QColor> colors;     // family or group name -> colour
+        QHash<QString, QString> aliases;   // group name -> family
+        QHash<QString, QString> categoryFamily;   // "More - System - <category>" -> family
+
+        SectionColors()
+        {
+            // Mid-tone colours, readable on light and dark themes.
+            colors = {
+                { "Software",            QColor( "#4a90d9" ) },
+                { "Hardware",            QColor( "#e0803a" ) },
+                { "System",              QColor( "#8e6cd8" ) },
+                { "Network",             QColor( "#2bb3a3" ) },
+                { "Security",            QColor( "#d9534f" ) },
+                { "Emulators",           QColor( "#c94fb0" ) },
+                { "Graphics",            QColor( "#e8668f" ) },
+                { "Multimedia",          QColor( "#d4a017" ) },
+                { "Games",               QColor( "#5cb85c" ) },
+                { "Development",         QColor( "#5f8dd3" ) },
+                { "Office",              QColor( "#3fa7c9" ) },
+                { "Education & Science", QColor( "#8bbf3c" ) },
+                { "Internet",            QColor( "#26a69a" ) },
+                { "Settings",            QColor( "#a0784f" ) },
+                { "Utilities",           QColor( "#7f8fa6" ) },
+                { "Benchmarks",          QColor( "#e8743b" ) },
+                { "Information",         QColor( "#9b6fd6" ) },
+                { "Other",               QColor( "#8a8a8a" ) },
+            };
+
+            // Stand-alone groups that belong to a family above.
+            aliases = {
+                { "High Availability",       "System" },
+                { "Network Services",        "Network" },
+                { "Security and Users",      "Security" },
+                { "Virtualization",          "Emulators" },
+                { "EmuDeck",                 "Emulators" },
+                { "EmuDeck-managed Emulators", "Emulators" },
+                { "Game Engines & Ports",    "Emulators" },
+                { "Emulation Helpers",       "Emulators" },
+                { "Emulation Frontends",     "Emulators" },
+                { "Virtual Machines & Wine", "Emulators" },
+                { "SRS System Information",  "Information" },
+                { "Support",                 "Other" },
+                { "Miscellaneous",           "Other" },
+            };
+
+            // system categories that belong to an existing family
+            categoryFamily = {
+                { "Networking",          "Network" },
+                { "Security & Accounts", "Security" },
+                { "Hardware & Drivers",  "Hardware" },
+                { "Gaming Helpers",      "Games" },
+                { "Other",               "Utilities" },
+                { "System Info & Monitors", "Information" },
+            };
+
+            // the other system categories: hand-picked so they stay easy to tell apart
+            const QHash<QString, QColor> systemColors = {
+                { "AI & LLM",                QColor( "#b07cff" ) },
+                { "Archives & Compression",  QColor( "#c49a6c" ) },
+                { "Backup & Snapshots",      QColor( "#4fb3d9" ) },
+                { "Containers",              QColor( "#2e86c1" ) },
+                { "Disks & Partitions",      QColor( "#f39c12" ) },
+                { "Distro Tools",            QColor( "#1abc9c" ) },
+                { "Files & File Managers",   QColor( "#f1c40f" ) },
+                { "Packages & App Stores",   QColor( "#ff6f61" ) },
+                { "Peripherals & RGB",       QColor( "#ff4fd8" ) },
+                { "Processes & Diagnostics", QColor( "#a3e048" ) },
+                { "Search & Launchers",      QColor( "#00bcd4" ) },
+                { "Terminals & Shell",       QColor( "#7dcea0" ) },
+                { "Text & Notes",            QColor( "#e8a0bf" ) },
+                { "Theming & Desktop",       QColor( "#ffb3a7" ) },
+            };
+            for ( auto it = systemColors.cbegin(); it != systemColors.cend(); ++it )
+                colors.insert( "System: " + it.key(), it.value() );
+
+            QSettings ini( iniPath(), QSettings::IniFormat );
+            const QString m = ini.value( "Mode", "headers" ).toString().toLower();
+            if ( m == "off" )
+                mode = SectionColorsOff;
+            else if ( m == "blocks" )
+                mode = SectionColorsBlocks;
+
+            ini.beginGroup( "Colors" );
+            for ( const QString &key : ini.childKeys() )
+            {
+                QColor c( ini.value( key ).toString() );
+                if ( c.isValid() )
+                    colors.insert( key, c );
+            }
+            ini.endGroup();
+
+            // [Aliases] Group name=Family, added to (or replacing) the built-in ones
+            ini.beginGroup( "Aliases" );
+            for ( const QString &key : ini.childKeys() )
+            {
+                const QString f = ini.value( key ).toString().trimmed();
+                if ( !f.isEmpty() )
+                    aliases.insert( key, f );
+            }
+            ini.endGroup();
+        }
+
+        QColor newFamilyColor( const QString &f )
+        {
+            QList<int> hues;
+            for ( const QColor &c : colors )
+                if ( c.hslHue() >= 0 && c.hslSaturation() > 60 )
+                    hues << c.hslHue();
+
+            int best = qHash( f ) % 360, bestGap = -1;
+            for ( int h = 0; h < 360; h += 3 )
+            {
+                int gap = 360;
+                for ( int u : hues )
+                {
+                    int d = qAbs( h - u );
+                    gap = qMin( gap, qMin( d, 360 - d ) );
+                }
+                if ( gap > bestGap )
+                {
+                    bestGap = gap;
+                    best = h;
+                }
+            }
+
+            const QColor c = QColor::fromHsl( best, 150, 135 );
+            colors.insert( f, c );
+
+            if ( !f.contains( '/' ) )   // "/" would split the INI key
+            {
+                QSettings ini( iniPath(), QSettings::IniFormat );
+                ini.setValue( "Colors/" + f, c.name() );
+            }
+            return c;
+        }
+
+        QString family( const QString &name ) const
+        {
+            if ( aliases.contains( name ) )
+                return aliases.value( name );
+
+            QString f = name.section( " - ", 0, 0 ).trimmed();
+
+            // "More - Graphics" -> Graphics; "More - System - Networking" -> each
+            // system category gets a colour of its own (matching families where
+            // one fits, e.g. Networking -> Network, otherwise its own new colour)
+            if ( f == "More" )
+            {
+                QString sub = name.section( " - ", 1, 1 ).trimmed();
+                if ( sub == "System" )
+                {
+                    QString cat = name.section( " - ", 2 ).trimmed();
+                    if ( cat.isEmpty() )
+                        return "Utilities";
+                    return categoryFamily.value( cat, "System: " + cat );
+                }
+                if ( sub == "Emulators" || sub == "Benchmarks" || sub == "Settings" )
+                    return sub;
+                return colors.contains( sub ) ? sub : f;
+            }
+
+            // "Real-Time Corruptor - RTCV 5.1.1" is an emulator tool
+            if ( f == "Real-Time Corruptor" )
+                return "Emulators";
+
+            return f;
+        }
+    };
+
+    SectionColors &instance()
+    {
+        static SectionColors sc;
+        return sc;
+    }
+}
+
+QColor sectionColor( const QString &shownName )
+{
+    // a renamed section keeps the colour of its installed name
+    const QString groupName = installedName( shownName );
+
+    SectionColors &sc = instance();
+
+    if ( sc.mode == SectionColorsOff || groupName.isEmpty() )
+        return QColor();
+
+    // A full group name in the ini wins over its family.
+    if ( sc.colors.contains( groupName ) )
+        return sc.colors.value( groupName );
+
+    QString f = sc.family( groupName );
+    if ( sc.colors.contains( f ) )
+        return sc.colors.value( f );
+
+    // A new family (e.g. a section you added with a new genre) gets the hue
+    // furthest from every colour in use, saved to the ini so it stays the same
+    // and can be changed there.
+    return sc.newFamilyColor( f );
+}
+
+SectionColorMode sectionColorMode()
+{
+    return instance().mode;
+}
+
+void setSectionColorMode( SectionColorMode mode )
+{
+    instance().mode = mode;
+
+    static const char *names[] = { "off", "headers", "blocks" };
+    QSettings ini( iniPath(), QSettings::IniFormat );
+    ini.setValue( "Mode", names[mode] );   // Qt stores top-level keys under [General]
+}
