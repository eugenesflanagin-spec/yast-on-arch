+| but WITHOUT ANY WARRANTY; without even the implied warranty of
+| MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.   See the
+| GNU General Public License for more details.
+|
+ \***************************************************************************/
+
+/*
+ * ARCH PORT: your own layout, see layoutoverlay.h.
+ *
+ * Read with a small parser instead of QSettings: section names may contain
+ * commas and other characters that QSettings' INI format would interpret.
+ */
+
+#include "layoutoverlay.h"
+
+#include <QDir>
+#include <QFile>
+#include <QHash>
+#include <QTextStream>
+
+namespace
+{
+    struct Layout
+    {
+        QHash<QString, QString> moves;
+        QHash<QString, QString> names;
+
+        Layout()
+        {
+            QFile f( layoutFilePath() );
+            if ( !f.open( QIODevice::ReadOnly | QIODevice::Text ) )
+                return;
+
+            QTextStream in( &f );
+            in.setCodec( "UTF-8" );
+            QHash<QString, QString> *section = nullptr;
+
+            while ( !in.atEnd() )
+            {
+                const QString line = in.readLine().trimmed();
+
+                if ( line.isEmpty() || line.startsWith( ';' ) || line.startsWith( '#' ) )
+                    continue;
+
+                if ( line == "[Moves]" )
+                    section = &moves;
+                else if ( line == "[Names]" )
+                    section = &names;
+                else if ( line.startsWith( '[' ) )
+                    section = nullptr;
+                else if ( section && line.contains( '=' ) )
+                {
+                    const QString key = line.section( '=', 0, 0 ).trimmed();
+                    const QString value = line.section( '=', 1 ).trimmed();
+                    if ( !key.isEmpty() && !value.isEmpty() )
+                        section->insert( key, value );
+                }
+            }
+        }
+    };
+
+    const Layout &layout()
+    {
+        static const Layout l;
+        return l;
+    }
+}
+
+QString layoutFilePath()
+{
+    QString data = qEnvironmentVariable( "XDG_DATA_HOME" );
+    if ( data.isEmpty() )
+        data = QDir::homePath() + "/.local/share";
+
+    return data + "/yast-on-arch/layout.ini";
+}
+
+QString movedSection( const QString &desktopFileName )
+{
+    return layout().moves.value( desktopFileName );
+}
+
+QString renamedSection( const QString &groupId )
+{
+    return layout().names.value( groupId );
+}
+
+namespace
+{
+    QHash<QString, QString> &installedNames()
+    {
+        static QHash<QString, QString> names;
+        return names;
+    }
+}
+
+void rememberInstalledName( const QString &shownName, const QString &installedName )
+{
+    installedNames().insert( shownName, installedName );
+}
+
+QString installedName( const QString &shownName )
+{
+    return installedNames().value( shownName, shownName );
+}
