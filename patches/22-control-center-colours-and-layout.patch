+/*
+ * ARCH PORT: "Add or change..." dialog, see layoutdialog.h.
+ */
+
+#include "layoutdialog.h"
+#include "i18n.h"
+
+#include <QCheckBox>
+#include <QComboBox>
+#include <QDialogButtonBox>
+#include <QFileDialog>
+#include <QFormLayout>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QLineEdit>
+#include <QProcess>
+#include <QPushButton>
