+
+/*
+ * ARCH PORT: "Add or change..." dialog -- add programs and sections, move
+ * entries to another section and rename sections. Every change is made by
+ * the "yast" launcher (bin/yast-apps), the same commands as on the command
+ * line, so the dialog and the terminal always agree.
+ */
+
+#ifndef LAYOUTDIALOG_H
+#define LAYOUTDIALOG_H
+
+#include <QDialog>
+#include <QList>
+#include <QString>
+
+class QCheckBox;
+class QComboBox;
+class QLabel;
+class QLineEdit;
+class QTabWidget;
+
+struct LayoutSection
+{
+    QString id;
+    QString name;        // as shown now (after a rename)
+};
+
+struct LayoutEntry
+{
+    QString file;        // file name of the .desktop entry
+    QString name;        // as shown in the Control Center
+    QString section;     // section ID it is shown in now
+};
+
+class LayoutDialog : public QDialog
+{
+    Q_OBJECT
+
+public:
+    enum Page { AddApp, AddSection, MoveApp, RenameSection };
+
+    LayoutDialog( const QList<LayoutSection> &sections, const QList<LayoutEntry> &entries,
+                  QWidget *parent = nullptr );
+
+    void showPage( Page page, const QString &entryFile = QString() );
+
+    // true once something was changed (the Control Center needs a restart to show it)
+    bool changed() const { return m_changed; }
+
+private slots:
+    void addApp();
+    void addSection();
+    void moveApp( bool reset );
+    void renameSection( bool reset );
+
+private:
+    bool run( const QStringList &args );
+    void fillSectionBox( QComboBox *box );
+    QString chosenSection( QComboBox *box ) const;
+
+    QList<LayoutSection> m_sections;
+    QList<LayoutEntry> m_entries;
+    bool m_changed = false;
+
+    QTabWidget *m_tabs;
+    QLabel *m_result;
+
+    // Add a program
+    QLineEdit *m_appName, *m_appExec, *m_appIcon, *m_appComment, *m_appKeywords;
+    QComboBox *m_appSection;
+    QCheckBox *m_appTerminal;
+
+    // Add a section
+    QLineEdit *m_secName, *m_secIcon;
+    QComboBox *m_secGenre;
+
+    // Move an entry
+    QComboBox *m_moveEntry, *m_moveTo;
+
+    // Rename a section
+    QComboBox *m_renSection;
+    QLineEdit *m_renName;
+};
+
+#endif
