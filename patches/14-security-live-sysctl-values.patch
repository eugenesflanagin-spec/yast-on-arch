+      # ARCH PORT: yescrypt is Arch's login.defs default (shadow >= 4.14)
+      @encryption_methods = ["des", "md5", "sha256", "sha512", "yescrypt"]
 
       # All security settings
       @Settings = {
@@ -234,7 +235,8 @@
         "des"    => 8,
         "md5"    => 127,
         "sha256" => 127,
-        "sha512" => 127
+        "sha512" => 127,
