+// Group sidebar filter: while searching, show only the groups that contain a
+// matching module. (The stock regexp filter on column 2 compared the groups'
+// Comment, which group files don't have, so the sidebar never narrowed.)
+class GroupFilterProxyModel : public QSortFilterProxyModel
+{
+public:
+    GroupFilterProxyModel( QObject *parent ) : QSortFilterProxyModel( parent ), active( false ) {}
+
+    void setMatchingGroups( const QSet<QString> &g, bool on )
+    {
+	groups = g;
+	active = on;
+	invalidateFilter();
+    }
+
+protected:
+    virtual bool filterAcceptsRow( int row, const QModelIndex &parent ) const
+    {
+	if ( !active )
+	    return true;
+	QModelIndex idx = sourceModel()->index( row, YQDesktopFilesModel::Group, parent );
+	return groups.contains( sourceModel()->data( idx, Qt::UserRole ).toString() );
+    }
+
+private:
+    QSet<QString> groups;
+    bool active;
+};
