[Desktop Entry]
Type=Application
Categories=Settings;System;Qt;X-SuSE-YaST;X-SuSE-YaST-System;

X-KDE-ModuleType=Library
X-KDE-HasReadOnlyMode=true
X-SuSE-YaST-Call=kde_settings

X-SuSE-YaST-Group=System
X-SuSE-YaST-SortKey=40
# Deliberately NOT root-only: KCMs write per-user config under ~/.config, so
# running them as root would write to the wrong home.
X-SuSE-YaST-RootOnly=false
X-SuSE-YaST-Keywords=kde,plasma,desktop,settings,appearance,theme,kcm

Icon=preferences-system
Exec=/usr/bin/yast2 kde_settings

Name=KDE Plasma Settings
GenericName=Desktop Settings
Comment=Browse and open the KDE Plasma configuration modules installed on this system
StartupNotify=true
