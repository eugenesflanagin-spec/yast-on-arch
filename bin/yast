#!/bin/bash
# YaST on Arch Linux -- ported 2026-09-06.
#   ~/libyui-port/yast                     -> list available modules
#   ~/libyui-port/yast services-manager    -> run in ncurses (classic blue TUI)
#   ~/libyui-port/yast -q services-manager -> run with the Qt frontend
SELF="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
P="$SELF/prefix"
source "$SELF/yast-env.sh" >/dev/null 2>&1
export Y2DIR="$P/destdir/usr/share/YaST2"
export RUBYLIB="$P/destdir/usr/share/YaST2/lib:$RUBYLIB"
export LD_LIBRARY_PATH="$P/lib:$P/lib/yui:$LD_LIBRARY_PATH"
UI=ncurses; ASROOT=0
while :; do case "${1:-}" in
  -q) UI=qt;  shift ;;
  -g) UI=gtk; shift ;;
  -r) ASROOT=1; shift ;;
  *) break ;;
esac; done
# dark mode for the GTK front-end (and Qt via the platform theme)
if [ "$UI" = "gtk" ]; then
  export GTK_THEME="${YAST_GTK_THEME:-Adwaita:dark}"
  export GTK_APPLICATION_PREFER_DARK_THEME=1
  # Icon themes in ~/.local/share/icons are unreadable by the sandboxed glycin
  # SVG loader (it binds only /usr), which makes GTK abort. Force a system theme
  # via a private XDG_CONFIG_HOME so the user's own GTK settings are untouched.
  export XDG_CONFIG_HOME="$P/gtkconf"
  export XDG_DATA_DIRS="/usr/share:${XDG_DATA_DIRS:-/usr/local/share}"
  # On Wayland/KDE, GTK takes its icon theme from xdg-desktop-portal, which
  # OUTRANKS settings.ini -- so the private config above is ignored and the
  # user-local theme comes back. Disable the portal for this process only.
  export GTK_USE_PORTAL=0
fi
if [ -z "$1" ]; then
    echo "YaST on Arch  (prefix: $P)"
    echo "usage: yast [-q|-g] <module>   (-q = Qt GUI, -g = GTK GUI dark, default ncurses)"
    echo
    echo "available clients:"
    ls "$Y2DIR/clients"/*.rb 2>/dev/null | xargs -n1 basename | sed 's/\.rb$//' | sed 's/^/  /'
    exit 0
fi
if [ "$ASROOT" = 1 ] && [ "$(id -u)" != 0 ]; then
  # YaST checks Process.uid == 0 literally -- being in wheel is not enough.
  # sudo resets the environment, so pass the port's paths through explicitly.
  PASS="RUBYLIB=$RUBYLIB Y2DIR=$Y2DIR LD_LIBRARY_PATH=$LD_LIBRARY_PATH"
  PASS="$PASS GEM_PATH=$GEM_PATH PATH=$PATH Y2BASE_PLUGINDIR=$Y2BASE_PLUGINDIR"
  PASS="$PASS YAST_Y2BASE=$P/lib/YaST2/bin/y2base YAST_UI=$UI HOME=$HOME"
    [ "$UI" = gtk ] && PASS="$PASS XDG_CONFIG_HOME=$P/gtkconf XDG_DATA_DIRS=/usr/share GTK_USE_PORTAL=0"
  if [ "$UI" != ncurses ]; then
    # GUI as root on Wayland: go through XWayland and grant root access to it
    xhost +SI:localuser:root >/dev/null 2>&1
    PASS="$PASS DISPLAY=${DISPLAY:-:0} XAUTHORITY=${XAUTHORITY:-$HOME/.Xauthority}"
    PASS="$PASS QT_QPA_PLATFORM=xcb GDK_BACKEND=x11"
    [ "$UI" = gtk ] && PASS="$PASS GTK_THEME=${GTK_THEME:-Adwaita:dark}"
  fi
  exec sudo env $PASS "$P/lib/YaST2/bin/y2base" "$1" "$UI" "${@:2}"
fi
export YAST_Y2BASE="$P/lib/YaST2/bin/y2base" YAST_UI="$UI"
exec "$P/lib/YaST2/bin/y2base" "$1" "$UI" "${@:2}"
